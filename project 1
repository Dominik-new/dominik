notes=dict()
with open("notes.json", "r") as file:
    notes=json.load(file)
def update_notes():
    global notes
    with open("notes.json", "r") as file:
            notes = json.load(file)
def save_notes():
    with open("notes.json", "w") as file:
        json.dump(notes, file)
def add_notes(tittle, text):
    global notes
    notes[tittle] = text
    print("Заметка была добавлена")
def display_notes():
    update_notes()
    if len(notes)==0:
        print("Заметок пока нет")
    else:
        for tittle, text in notes.items():
            print(f"{tittle}:{text}")
def delete_notes(tittle):
    if tittle in notes.keys():
        del notes[tittle]
        print(f'Запись {tittle} удалена')
    else:
        print('Записи не существует')
